{
  "v": 1,
  "about": "The lookups the dynamic network mode may carry out (docs/adr/0011). Each adapter is one exact host, method and path template, with typed parameters; nothing an agent writes becomes a host, a path or a query of its own. class: reference (public reference data) or evidence_linked (a value taken from the evidence, sent where the evidence points). contact: passive (a third party's reference service) or active (the subject's own infrastructure may see it). disclosure: the class of case data the request carries out of the run. key: a host-managed key the fetch service adds, read from its own environment; an adapter whose key is not configured is refused. redirects: never followed, except an adapter's declared referral hosts, where the redirect must ask the same thing (its path ends with the original's). response.fields: the only fields delivered to the agent; the whole response is kept outside every VM.",
  "adapters": [
    {
      "name": "rdap_domain",
      "title": "RDAP registration record of a domain (rdap.org, following its referral to the registry)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "public_indicator",
      "scheme": "https",
      "host": "rdap.org",
      "method": "GET",
      "path": "/domain/{domain}",
      "params": { "domain": { "type": "domain" } },
      "max_bytes": 1048576,
      "redirects": {
        "follow": "referral",
        "max": 3,
        "hosts": ["rdap.verisign.com", "rdap.publicinterestregistry.org", "rdap.identitydigital.services", "pubapi.registry.google", "rdap.centralnic.com", "rdap.nominet.uk", "rdap.nic.fr", "rdap.denic.de", "rdap.sidn.nl", "rdap.dns.pl", "rdap.nic.ch", "rdap.registry.in", "rdap.cira.ca", "rdap.auda.org.au", "rdap.nic.br", "rdap.teleinfo.cn", "rdap.jprs.jp", "rdap.kr", "rdap.nic.tr"]
      },
      "terms": "https://about.rdap.org/"
    },
    {
      "name": "rdap_ip",
      "title": "RDAP registration record of a public IP address (rdap.org, following its referral to the RIR)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "public_indicator",
      "scheme": "https",
      "host": "rdap.org",
      "method": "GET",
      "path": "/ip/{ip}",
      "params": { "ip": { "type": "ip" } },
      "max_bytes": 1048576,
      "redirects": { "follow": "referral", "max": 3, "hosts": ["rdap.arin.net", "rdap.db.ripe.net", "rdap.apnic.net", "rdap.lacnic.net", "rdap.afrinic.net"] },
      "terms": "https://about.rdap.org/"
    },
    {
      "name": "rdap_autnum",
      "title": "RDAP registration record of an autonomous system (rdap.org, following its referral to the RIR)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "public_indicator",
      "scheme": "https",
      "host": "rdap.org",
      "method": "GET",
      "path": "/autnum/{asn}",
      "params": { "asn": { "type": "asn" } },
      "max_bytes": 1048576,
      "redirects": { "follow": "referral", "max": 3, "hosts": ["rdap.arin.net", "rdap.db.ripe.net", "rdap.apnic.net", "rdap.lacnic.net", "rdap.afrinic.net"] },
      "terms": "https://about.rdap.org/"
    },
    {
      "name": "crtsh",
      "title": "Certificate transparency: the certificates logged for a domain (crt.sh)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "public_indicator",
      "scheme": "https",
      "host": "crt.sh",
      "method": "GET",
      "path": "/",
      "query": [["q", "{domain}"], ["output", "json"]],
      "params": { "domain": { "type": "domain" } },
      "max_bytes": 8388608,
      "terms": "https://crt.sh/"
    },
    {
      "name": "nvd_cve",
      "title": "One CVE record from the NVD CVE API 2.0",
      "class": "reference",
      "contact": "passive",
      "disclosure": "public_indicator",
      "scheme": "https",
      "host": "services.nvd.nist.gov",
      "method": "GET",
      "path": "/rest/json/cves/2.0",
      "query": [["cveId", "{cve}"]],
      "params": { "cve": { "type": "cve" } },
      "max_bytes": 2097152,
      "rate": { "min_interval_ms": 6000 },
      "terms": "https://nvd.nist.gov/developers/terms-of-use"
    },
    {
      "name": "cisa_kev",
      "title": "CISA's Known Exploited Vulnerabilities catalogue (the whole feed; nothing of the case is sent)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "none",
      "scheme": "https",
      "host": "www.cisa.gov",
      "method": "GET",
      "path": "/sites/default/files/feeds/known_exploited_vulnerabilities.json",
      "params": {},
      "max_bytes": 16777216,
      "terms": "https://www.cisa.gov/known-exploited-vulnerabilities-catalog"
    },
    {
      "name": "circl_hashlookup",
      "title": "CIRCL hashlookup: is a file hash in a known-good set (a hash only, never a file)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "hash",
      "scheme": "https",
      "host": "hashlookup.circl.lu",
      "method": "GET",
      "path": "/lookup/{hash:algorithm}/{hash}",
      "params": { "hash": { "type": "hash" } },
      "max_bytes": 1048576,
      "terms": "https://www.circl.lu/services/hashlookup/"
    },
    {
      "name": "ripestat_prefix",
      "title": "RIPEstat prefix overview: the announcing AS and prefix of a public IP address or prefix",
      "class": "reference",
      "contact": "passive",
      "disclosure": "public_indicator",
      "scheme": "https",
      "host": "stat.ripe.net",
      "method": "GET",
      "path": "/data/prefix-overview/data.json",
      "query": [["resource", "{resource}"]],
      "params": { "resource": { "type": "ip_or_prefix" } },
      "max_bytes": 1048576,
      "terms": "https://stat.ripe.net/docs/data_api"
    },
    {
      "name": "ripestat_asn",
      "title": "RIPEstat AS overview: the holder and announcement of an autonomous system",
      "class": "reference",
      "contact": "passive",
      "disclosure": "public_indicator",
      "scheme": "https",
      "host": "stat.ripe.net",
      "method": "GET",
      "path": "/data/as-overview/data.json",
      "query": [["resource", "AS{asn}"]],
      "params": { "asn": { "type": "asn" } },
      "max_bytes": 1048576,
      "terms": "https://stat.ripe.net/docs/data_api"
    },
    {
      "name": "nominatim_reverse",
      "title": "Nominatim reverse geocoding: the address OpenStreetMap has at a coordinate",
      "class": "reference",
      "contact": "passive",
      "disclosure": "coordinate",
      "scheme": "https",
      "host": "nominatim.openstreetmap.org",
      "method": "GET",
      "path": "/reverse",
      "query": [["lat", "{lat}"], ["lon", "{lon}"], ["format", "jsonv2"]],
      "params": { "lat": { "type": "lat" }, "lon": { "type": "lon" } },
      "max_bytes": 1048576,
      "rate": { "min_interval_ms": 1100 },
      "terms": "https://operations.osmfoundation.org/policies/nominatim/"
    },
    {
      "name": "nominatim_search",
      "title": "Nominatim search: the places OpenStreetMap has for a place name or address (at most five)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "coordinate",
      "scheme": "https",
      "host": "nominatim.openstreetmap.org",
      "method": "GET",
      "path": "/search",
      "query": [["q", "{q}"], ["format", "jsonv2"], ["limit", "5"]],
      "params": { "q": { "type": "place_text" } },
      "max_bytes": 1048576,
      "rate": { "min_interval_ms": 1100 },
      "terms": "https://operations.osmfoundation.org/policies/nominatim/"
    },
    {
      "name": "overpass_around",
      "title": "Overpass: the OpenStreetMap features with one tag around a coordinate (a structured query, never free Overpass QL)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "coordinate",
      "scheme": "https",
      "host": "overpass-api.de",
      "method": "GET",
      "path": "/api/interpreter",
      "query": [["data", "[out:json][timeout:25];nwr(around:{radius},{lat},{lon}){tag};out tags center 50;"]],
      "params": {
        "lat": { "type": "lat" },
        "lon": { "type": "lon" },
        "radius": { "type": "int", "min": 1, "max": 2000 },
        "tag": { "type": "osm_tag", "keys": ["amenity", "shop", "tourism", "leisure", "building", "historic", "office", "railway", "public_transport", "highway", "name", "brand", "craft", "man_made", "place"] }
      },
      "max_bytes": 2097152,
      "rate": { "min_interval_ms": 2000 },
      "terms": "https://wiki.openstreetmap.org/wiki/Overpass_API#Public_Overpass_API_instances"
    },
    {
      "name": "youtube_oembed",
      "title": "YouTube oEmbed: a video's title, and nothing else (no comments, no related videos, no search)",
      "class": "reference",
      "contact": "passive",
      "disclosure": "public_indicator",
      "exception": "social",
      "scheme": "https",
      "host": "www.youtube.com",
      "method": "GET",
      "path": "/oembed",
      "query": [["url", "https://www.youtube.com/watch?v={video_id}"], ["format", "json"]],
      "params": { "video_id": { "type": "youtube_id" } },
      "max_bytes": 65536,
      "response": { "fields": ["title"] },
      "terms": "https://developers.google.com/youtube/terms/api-services-terms-of-service"
    },
    {
      "name": "http_head",
      "title": "HEAD of one exact URL found in the evidence, its redirect never followed (the Location is returned as a new destination). Active contact: the host sees the request.",
      "class": "evidence_linked",
      "contact": "active",
      "disclosure": "public_indicator",
      "scheme": "from_url",
      "host": "from_url",
      "method": "HEAD",
      "path": "from_url",
      "params": { "url": { "type": "evidence_url" } },
      "max_bytes": 0
    },
    {
      "name": "virustotal_file",
      "title": "VirusTotal file report by hash (a hash only, never a file); only with a key the operator configured on the host",
      "class": "reference",
      "contact": "passive",
      "disclosure": "hash",
      "scheme": "https",
      "host": "www.virustotal.com",
      "method": "GET",
      "path": "/api/v3/files/{hash}",
      "params": { "hash": { "type": "hash" } },
      "max_bytes": 4194304,
      "key": { "env": "DFIRSWARM_VT_API_KEY", "header": "x-apikey" },
      "rate": { "min_interval_ms": 15000 },
      "terms": "https://docs.virustotal.com/docs/terms-of-service"
    }
  ]
}
