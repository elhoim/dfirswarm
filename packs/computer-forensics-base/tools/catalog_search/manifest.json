{
  "name": "catalog_search",
  "description": "Search catalog filelist/timeline/bodyfile with a regex; returns matching lines (capped).",
  "params": {
    "pattern": {
      "type": "string",
      "description": "Regex to search",
      "required": true
    },
    "which": {
      "type": "string",
      "description": "filelist|timeline|bodyfile|fsstat|partitions",
      "required": false
    },
    "ignore_case": {
      "type": "boolean",
      "description": "Case-insensitive (default true)",
      "required": false
    },
    "limit": {
      "type": "integer",
      "description": "Max lines to return (default 200)",
      "required": false
    },
    "exclude": {
      "type": "string",
      "description": "Regex of lines to drop",
      "required": false
    },
    "catalog": {
      "type": "string",
      "description": "The catalogue directory under catalog/ when there is more than one (default: the only one)",
      "required": false
    },
    "partition": {
      "type": "string",
      "description": "The filesystem's directory in the catalogue, p<first sector> (e.g. p2048), when there is more than one (default: the only one)",
      "required": false
    }
  },
  "runtime": "python3",
  "entry": "run.py",
  "timeout_seconds": 30,
  "example": "{\"pattern\": \"SysInternal\", \"which\": \"filelist\"}",
  "by": "sd1d100",
  "at": "2026-09-18T14:14:47.839Z",
  "version": 5,
  "sha256": "36b3df5c9827c6f68fbdd03f9f5e38a8b3afbad3d609cf5b6f8a8a72b4023a46"
}
