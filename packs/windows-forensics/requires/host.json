      "why": "List the volume shadow copies on an image, with each store's creation time: the volume as it was before a cleanup.",
      "install": {
        "brew": "brew install libvshadow",
        "apt": "apt-get install -y libvshadow-utils"
      },
      "licence": "LGPL-3.0-or-later",
