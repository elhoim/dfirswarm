      "install": {
        "brew": "brew install libvshadow",
        "apt": "apt-get install -y libvshadow-utils"
      },
      "licence": "LGPL-3.0-or-later",
      "redistributable": false
    },
    {
      "name": "vol",
      "package": "volatility3",
      "optional": true,
      "why": "Memory analysis, when the host has it. Not shipped with this pack: the Volatility Software License and AGPL-3.0 do not combine in one work, so it is invoked as an executable or not at all.",
      "install": {
        "brew": "python3 -m pip install volatility3",
        "apt": "python3 -m pip install volatility3"
      },
      "licence": "Volatility Software License 1.0",
      "redistributable": false
    },
