{
  "binaries": [
    {
      "name": "esedbexport",
      "package": "libesedb",
      "why": "Read the ESE databases Windows keeps: WebCacheV01.dat for browsing, SRUDB.dat for application and network use.",
      "install": {
        "brew": "brew install libesedb",
        "apt": "apt-get install -y libesedb-utils"
      },
      "licence": "LGPL-3.0-or-later",
      "redistributable": false
    },
    {
      "name": "yara",
      "package": "yara",
      "why": "Sweep an extract or a directory against rules and report every match with its offset.",
      "install": {
        "brew": "brew install yara",
        "apt": "apt-get install -y yara"
      },
      "licence": "BSD-3-Clause",
      "redistributable": false
    },
    {
      "name": "strings",
      "package": "binutils",
      "why": "First pass over a binary before a parser is chosen.",
      "install": {
        "brew": "brew install binutils",
        "apt": "apt-get install -y binutils"
      },
      "licence": "GPL-3.0-or-later",
      "redistributable": false
    },
    {
      "name": "vshadowinfo",
