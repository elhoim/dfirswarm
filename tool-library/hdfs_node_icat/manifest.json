{
  "name": "hdfs_node_icat",
  "description": "Extract an inode from a cluster node's image with icat and hash what it wrote. node picks one of the HDFS case's three images; image names any other.",
  "params": {
    "node": {
      "type": "string",
      "description": "master | slave1 | slave2, or use image"
    },
    "inode": {
      "type": "string",
      "description": "Inode to extract"
    },
    "output": {
      "type": "string",
      "description": "Where to write it"
    },
    "image": {
      "type": "string",
      "description": "Image to read, instead of a node name"
    },
    "offset": {
      "type": "integer",
      "description": "Sector offset (default 2048)"
    }
  },
  "runtime": "python3",
  "entry": "run.py",
  "requires": [
    "icat"
  ],
  "timeout_seconds": 60,
  "example": "{\"node\":\"slave2\",\"inode\":2229804,\"output\":\"work/s9a5f03/s2_cluster.service\"}",
