{
  "name": "icat_extract",
  "description": "Extract a file from the E01 image by inode to a specified output path. Returns JSON with path, size, and sha256 hash.",
  "params": {
    "inode": {
      "type": "integer",
      "description": "Inode number to extract from the E01 image",
      "required": true
    },
    "output": {
      "type": "string",
      "description": "Output file path (relative to sandbox)",
      "required": true
    },
    "image": {
      "type": "string",
      "description": "E01/raw image path (default inputs/AF-Case2.E01)"
    },
    "offset": {
      "type": "integer",
      "description": "Volume offset in sectors for icat -o (default 0)"
    }
  },
  "runtime": "python3",
  "entry": "run.py",
  "requires": [
    "icat"
  ],
  "timeout_seconds": 30,
  "by": "s864a08",
  "at": "2026-09-18T16:09:29.146Z",
  "version": 3,
  "sha256": "e3c618b2418da5a5ab3510f6930d5de9e80fa908d477cc0430a867d4571f5d6e"
}
