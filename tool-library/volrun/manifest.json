{
  "name": "volrun",
  "description": "Run a Volatility 3 plugin against a memory image with typed arguments. Returns stdout/stderr.",
  "use": {
    "extensions": [
      ".raw",
      ".mem",
      ".vmem",
      ".lime",
      ".dmp"
    ],
    "magic": [
      {
        "offset": 0,
        "hex": "454d694c"
      },
      {
        "offset": 0,
        "hex": "5041474544553634"
      },
      {
        "offset": 0,
        "hex": "5041474544554d50"
      }
    ]
  },
  "params": {
    "image": {
      "type": "string",
      "description": "Memory image path",
      "required": true
    },
    "plugin": {
      "type": "string",
      "description": "Volatility 3 plugin name, e.g. windows.pslist",
      "required": true
    },
    "args": {
      "type": "array",
      "description": "Extra argv after the plugin (each element is one argument, not shell-split)"
    }
  },
  "runtime": "python3",
  "entry": "run.py",
  "requires": [
    "vol"
  ],
  "timeout_seconds": 120,
  "example": "{\"image\":\"inputs/ransomcare5.dmp\",\"plugin\":\"windows.pslist\",\"args\":[\"--pid\",\"356\"]}",
  "by": "s69d306",
  "at": "2026-09-18T21:58:14.314Z",
  "version": 2,
  "sha256": "fb0bc73d2b96bf3d4029e0597e40dda02b4ba5cbfe28cd4aba534db0ed55cbd3"
}
