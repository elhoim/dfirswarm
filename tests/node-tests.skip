# Node suites that `npm test` does not run (scripts/test-node.ts runs every
# other tests/**/*.test.ts). One path per line, with the reason after a #.
# Keep it short: a suite belongs here only when it must not run beside the rest.
tests/vm-integration.test.ts      # boots microVMs where the host can: npm run test:vm
tests/vm-jobs.test.ts             # boots microVMs where the host can: npm run test:vm
tests/vm-secret-rotation.test.ts  # boots microVMs where the host can: npm run test:vm
tests/job-observe-vm.test.ts      # by hand on a host that boots microVMs, with SWARM_JOB_OBSERVE_VM=1
